# LUNE — server configuration
PORT=3000
NODE_ENV=development

# Stashi / Postgres
DATABASE_URL="postgresql://user:password@host:6432/database?sslmode=require"
PGSSLMODE=require

# Public brand configuration (Part 1 will complete the rebrand)
VITE_BRAND_NAME="Lune"
VITE_PHONE_NUMBER="254700000000"
VITE_LOCATION="Nairobi, Kenya"

# Paystack — public key may reach the browser; secret key must stay server-side.
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key_here"
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key_here"

# Legacy Firebase variables retained only until the old upload path is removed.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
