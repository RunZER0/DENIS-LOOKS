# Lune server runtime
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL="http://localhost:3000"

# Stashi / PostgreSQL
DATABASE_URL="postgresql://user:password@host:6432/database?sslmode=require"
PGSSLMODE=require

# Paystack
# Never expose PAYSTACK_SECRET_KEY to the browser or commit a real key.
PAYSTACK_SECRET_KEY="sk_test_replace_me"
# Reserved for a future browser-side Paystack checkout; the current checkout is server-initialised.
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
# Webhook URL: https://your-public-domain/api/paystack/webhook
# Webhook signatures are verified with PAYSTACK_SECRET_KEY in this application.

# Booking email notifications — server-side only
BREVO_API_KEY=""
LUNE_EMAIL_FROM="Lune <bookings@example.com>"

# Comma-separated accounts allowed to open /admin.html
LUNE_ADMIN_EMAILS=""

# Allocation behavior
LUNE_PARTNER_RESPONSE_MINUTES=15
